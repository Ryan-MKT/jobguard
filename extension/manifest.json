{
  "manifest_version": 3,
  "name": "求職門神",
  "version": "0.1.0",
  "description": "在求職網站浮現公司風險資訊（違規/訴訟/新聞）",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "求職門神",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "*://*.104.com.tw/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.104.com.tw/*"],
      "js": [
        "content/parsers/104.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
