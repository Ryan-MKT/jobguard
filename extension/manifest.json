{
  "manifest_version": 3,
  "name": "求職門神 JobGuard",
  "version": "1.0.0",
  "description": "在 104 求職網站標示公司風險：勞基法違規、勞資訴訟、近期新聞，資料來自政府開放資料，本機運算不上傳。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "求職門神",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.104.com.tw/*",
    "https://ryan-mkt.github.io/*",
    "https://news.google.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.104.com.tw/*"],
      "js": [
        "content/parsers/104.js",
        "content/overlay.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
